# ---------------------------------------------------------------------------
# BMZ Trade Lab — environment template
# Copy to .env and adjust. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API -------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
# Comma-separated list of origins allowed to call the API with credentials.
API_CORS_ORIGINS=http://localhost:3000

# --- Web -------------------------------------------------------------------
WEB_PORT=3000
WEB_URL=http://localhost:3000
# Read by the browser bundle. Must be publicly reachable in production.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://bmz:bmz_dev_password@localhost:5432/bmz_trade_lab?schema=public

# --- Redis (sessions, rate limiting, BullMQ queues) ------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Cookie domain; leave blank for host-only cookies in development.
AUTH_COOKIE_DOMAIN=
# Set to true when the API is served over HTTPS.
AUTH_COOKIE_SECURE=false

# --- Object storage (S3-compatible: MinIO, Cloudflare R2, AWS S3) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bmz-trade-lab
S3_ACCESS_KEY_ID=bmz_minio
S3_SECRET_ACCESS_KEY=bmz_minio_dev_password
# MinIO needs path-style addressing; most cloud providers do not.
S3_FORCE_PATH_STYLE=true

# --- Email -----------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="BMZ Trade Lab <no-reply@bmztradelab.com>"

# ---------------------------------------------------------------------------
# Modules below are scaffolded but inactive until credentials are supplied.
# ---------------------------------------------------------------------------

# --- Billing (Stripe) — abstracted, no charges while unset -----------------
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Broker / prop-firm sync ----------------------------------------------
BROKER_SYNC_ENABLED=false
# 32-byte base64 key used to encrypt stored broker credentials at rest.
BROKER_CREDENTIALS_ENCRYPTION_KEY=

# --- Historical market data (replay / backtesting) ------------------------
MARKET_DATA_ENABLED=false
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# --- AI assistant ----------------------------------------------------------
AI_ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
